<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("partials/head", { title: "Admin Users - Worklix" }) %>
</head>
<body>
  <%- include("partials/navbar") %>
  <%- include("partials/alerts", { query }) %>
  <div class="container dashboard-page">
    <h1>Manage Users</h1>
    <p class="dashboard-subtitle">Adjust account roles for jobseekers, employers, and administrators.</p>
    <% if (users && users.length > 0) { %>
      <% users.forEach(user => { %>
        <div class="job-card">
          <h3><%= user.name %></h3>
          <p><%= user.email %></p>
          <p>Role: <%= user.role %></p>
          <form action="/admin/users/<%= user._id %>/role" method="post">
            <select name="role">
              <option value="jobseeker">jobseeker</option>
              <option value="employer">employer</option>
              <option value="admin">admin</option>
            </select>
            <button type="submit">Update Role</button>
          </form>
        </div>
      <% }) %>
    <% } else { %>
      <p>No users found.</p>
    <% } %>
  </div>
  <%- include("partials/footer") %>
</body>
</html>
