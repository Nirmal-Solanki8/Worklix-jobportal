<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("partials/head", { title: "About - Worklix" }) %>
  <link rel="stylesheet" href="/css/about.css">
</head>

<body>
  <%- include("partials/navbar") %>

  <section class="about-page">

    <div class="about-card">

      <!-- LEFT -->
      <div class="about-left">
        <span class="about-badge">ABOUT WORKLIX</span>

        <h1>Smart Hiring Starts Here </h1>

        <p class="about-desc">
          Worklix is a modern hiring platform that connects job seekers with 
          companies in the most efficient way possible. We combine technology, 
          simplicity, and smart matching to improve the hiring experience.
        </p>

        <p class="about-desc">
          Whether you're searching for opportunities or hiring top talent, 
          Worklix helps you move faster with confidence.
        </p>

        <!-- STATS -->
        <div class="about-stats">
          <div class="stat">
            <h2>10K+</h2>
            <span>Jobs Posted</span>
          </div>
          <div class="stat">
            <h2>5K+</h2>
            <span>Companies</span>
          </div>
          <div class="stat">
            <h2>20K+</h2>
            <span>Active Users</span>
          </div>
        </div>
      </div>

      <!-- RIGHT -->
      <div class="about-right">

        <div class="about-box">
          <h3> Mission</h3>
          <p>Empowering careers by simplifying the hiring journey.</p>
        </div>

        <div class="about-box">
          <h3> Vision</h3>
          <p>Building the most trusted and intelligent job platform.</p>
        </div>

        <div class="about-box">
          <h3> Platform</h3>
          <p>All-in-one solution for job seekers and recruiters.</p>
        </div>

      </div>

    </div>

  </section>

  <%- include("partials/footer") %>
</body>
</html>