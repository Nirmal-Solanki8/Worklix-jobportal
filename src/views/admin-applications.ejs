<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("partials/head", { title: "Admin Applications - Worklix" }) %>
</head>
<body>
  <%- include("partials/navbar") %>
  <%- include("partials/alerts", { query }) %>
  <div class="container dashboard-page">
    <h1>Manage Applications</h1>
    <p class="dashboard-subtitle">Monitor submissions across all jobs and keep application states consistent.</p>
    <% if (applications && applications.length > 0) { %>
      <% applications.forEach(app => { %>
        <div class="job-card" style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px;">
          <div>
            <h3 style="margin-bottom:4px;"><%= app.applicant ? app.applicant.name : "Candidate" %></h3>
            <p style="color:var(--text-muted); font-size:0.9rem;">
              Role: <strong><%= app.job ? app.job.title : "Archived Position" %></strong> &bull; <%= app.job ? app.job.company : "" %>
            </p>
            <p style="color:var(--text-muted); font-size:0.85rem; margin-top:4px;">Recruiter: <%= app.recruiter ? app.recruiter.name : "-" %></p>
          </div>
          <div>
            <span class="status-pill status-pill--<%= app.status %>"><%= app.status %></span>
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <p>No applications found.</p>
    <% } %>
  </div>
  <%- include("partials/footer") %>
</body>
</html>
