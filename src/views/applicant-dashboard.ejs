<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("partials/head", { title: "Applicant Dashboard - Worklix" }) %>
</head>
<body>
  <%- include("partials/navbar") %>
  <%- include("partials/alerts", { query }) %>

  <div class="container dashboard-page">
    <h1>My Applications</h1>
    <p class="dashboard-subtitle">Track your submitted roles and withdraw applications when needed.</p>

    <% if (applications && applications.length > 0) { %>
      <% applications.forEach(app => { %>
        <div class="job-card">
          <h3><%= app.job ? app.job.title : "Deleted Job" %></h3>
          <p><%= app.job ? app.job.company : "-" %></p>
          <p>Status: <%= app.status %></p>
          <form action="/applications/<%= app._id %>/withdraw" method="post">
            <button type="submit">Withdraw</button>
          </form>
        </div>
      <% }) %>
    <% } else { %>
      <p>You have not applied to any jobs yet.</p>
    <% } %>
  </div>
  <%- include("partials/footer") %>
</body>
</html>