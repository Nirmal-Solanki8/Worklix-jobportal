<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("partials/head", { title: "Admin Jobs - Worklix" }) %>
</head>
<body>
  <%- include("partials/navbar") %>
  <%- include("partials/alerts", { query }) %>
  <div class="container dashboard-page">
    <h1>Manage Jobs</h1>
    <p class="dashboard-subtitle">Review all posted jobs and track recruiter ownership and status.</p>
    <% if (jobs && jobs.length > 0) { %>
      <% jobs.forEach(job => { %>
        <div class="job-card" style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px;">
          <div>
            <h3 style="margin-bottom:4px;"><%= job.title %></h3>
            <p style="color:var(--text-muted); font-size:0.9rem;"><strong><%= job.company %></strong> &bull; <%= job.location %></p>
            <p style="color:var(--text-muted); font-size:0.85rem; margin-top:4px;">Recruiter: <%= job.recruiter ? job.recruiter.name : "-" %></p>
          </div>
          <div style="display:flex; align-items:center; gap:12px;">
            <span class="chip" style="text-transform:uppercase; font-size:0.75rem; font-weight:800;"><%= job.status %></span>
            <a href="/jobs/<%= job._id %>" style="font-size:0.85rem; font-weight:700; color:var(--secondary); text-decoration:none;">View &rarr;</a>
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <p>No jobs found.</p>
    <% } %>
  </div>
  <%- include("partials/footer") %>
</body>
</html>
